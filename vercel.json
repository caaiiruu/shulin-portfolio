{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Static v247 artifact: dependency install not required'",
  "buildCommand": "echo 'Static v247 artifact: build already verified'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/site/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/site/content/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/site",
      "destination": "/site/index.html"
    },
    {
      "source": "/site/",
      "destination": "/site/index.html"
    },
    {
      "source": "/site/work",
      "destination": "/site/work.html"
    },
    {
      "source": "/site/work/:projectId*",
      "destination": "/site/work.html"
    },
    {
      "source": "/site/profile",
      "destination": "/site/profile.html"
    },
    {
      "source": "/site/playground",
      "destination": "/site/experiments.html"
    }
  ]
}
