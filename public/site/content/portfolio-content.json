          "research": {
            "study": {
              "name": "Voucher Card Design UT",
              "method": "Unmoderated usability test",
              "platform": "UXArmy",
              "launchDate": "18 December 2024",
              "participants": 15,
              "groupStructure": "3 groups of 5 participants",
              "concepts": [
                "A - compact image-led card",
                "B - wider full-detail card",
                "C - text-led card without image",
                "D - existing card"
              ]
            },
            "keyFindings": [
              {
                "finding": "Participants valued both glanceability and complete information.",
                "evidence": "A received 8 selections and B received 7; the no-image C received 0, while the existing D received 2.",
                "claimBoundary": "Treat these as selections, not mutually exclusive percentages."
              },
              {
                "finding": "Colour was attractive but not self-explanatory.",
                "evidence": "12 participants preferred differentiated colours, but only 3 recognised the intended Free Shipping and Purchase-with-Purchase meanings."
              },
              {
                "finding": "The most important information was utility-first.",
                "evidence": [
                  "Discount value: 14 selections",
                  "Where the Voucher can be used: 13",
                  "Redemption condition: 12",
                  "Product image or icon: 12 after qualitative adjustment",
                  "Validity period: 11",
                  "Voucher type: 10",
                  "Owned quantity: 6"
                ]
              },
              {
                "finding": "Voucher quantity could be misread as public stock.",
                "evidence": "2 participants interpreted x8 / 8 left as the number remaining for all customers rather than their personal quantity."
              },
              {
                "finding": "Contextual relevance mattered more than broad exposure.",
                "evidence": "Participants found PDP Voucher cards useful when already interested in the item, while the Omni landing page required better personalisation."
              },
              {
                "finding": "Applicable-first checkout grouping supported selection.",
                "evidence": "Participants described the Applicable section and eligible items as making usable Vouchers easier to identify."
              },
              {
