{
  "name": "shulin-portfolio-v53",
  "version": "0.1.45",
  "private": true,
  "displayName": "Shulin Portfolio V45",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run validate:design && npm run build && node --test tests/rendered-html.test.mjs tests/portfolio-control-plane-governance.test.mjs tests/portfolio-automation.test.mjs tests/portfolio-r181-experiments.test.mjs",
    "test:routes": "npm run build && node --test tests/project-detail-routes.test.mjs",
    "validate:ssot": "node public/site/qa/ssot-governance.mjs && node scripts/content-completeness-audit.mjs",
    "validate:content-completeness": "node scripts/content-completeness-audit.mjs",
    "validate:automation": "node scripts/portfolio-automation.mjs validate",
    "automation:inspect": "node scripts/portfolio-automation.mjs inspect",
    "automation:validate-work-order": "node scripts/portfolio-automation.mjs validate-work-order",
    "automation:render-report": "node scripts/portfolio-automation.mjs render-report",
    "validate:design": "npm run validate:ssot && node public/site/qa/design-system-lint.mjs && node public/site/qa/token-governance.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
